#!/bin/sh
# The leak guard (tools/leak_guard.py) on a push to the public repository (tools/passed.py's REPO): each commit pushed,
# its message and its tree, against the household terms in the private folder and the images someone looked at; a push
# anywhere else passes.
# Installed as .git/hooks/pre-push: ln -s ../../tools/git-hooks/leak-guard .git/hooks/pre-push
top=$(git rev-parse --show-toplevel) || exit 1
python="$(git rev-parse --path-format=absolute --git-common-dir)/../.venv/bin/python"  # A worktree's main checkout.
[ -x "$python" ] || python="$top/.venv/bin/python"
exec "$python" "$top/tools/leak_guard.py" push "$@"
